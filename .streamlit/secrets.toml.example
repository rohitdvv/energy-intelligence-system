# Copy this file to .streamlit/secrets.toml and fill in your real API keys.
# NEVER commit secrets.toml to version control — it is already in .gitignore.
#
# Free API key registration:
#   EIA_API_KEY   — https://www.eia.gov/opendata/register.php
#   FRED_API_KEY  — https://fred.stlouisfed.org/docs/api/api_key.html
#   ANTHROPIC_API_KEY — https://console.anthropic.com/

EIA_API_KEY = "your_eia_api_key_here"
FRED_API_KEY = "your_fred_api_key_here"
ANTHROPIC_API_KEY = "your_anthropic_api_key_here"

# Access codes. Chat and Committee make paid Claude calls, and the Observatory
# shows activity from every viewer, so each stays locked until its code is set.
# Use at least 16 characters. To generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
AI_ACCESS_CODE = "your_ai_access_code_here"
OBSERVATORY_ACCESS_CODE = "your_observatory_access_code_here"
